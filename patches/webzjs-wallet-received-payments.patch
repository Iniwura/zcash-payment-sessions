+/// The status of a received payment output.
+#[derive(Debug, Clone, Copy, Serialize, Deserialize, PartialEq)]
+#[wasm_bindgen]
+pub enum ReceivedPaymentStatusType {
+    /// The transaction is mined in the main chain.
+    Mined,
+    /// The transaction is pending and has not been mined in the main chain.
+    Pending,
+    /// The transaction expired without being mined.
+    Expired,
+    /// The transaction was previously mined but is no longer in the main chain.
+    Reorged,
+}
+
+/// A single received shielded payment output.
+///
+/// Unlike transaction history entries, this type preserves output identity so callers can
+/// safely match one payment output to at most one application-level payment.
+#[derive(Debug, Clone, Serialize, Deserialize)]
+#[wasm_bindgen(inspectable)]
+pub struct ReceivedPayment {
+    /// Stable output identity: <txid>:<pool>:<output-index>.
+    payment_id: String,
+    /// Hex-encoded transaction ID.
+    txid: String,
+    /// Zatoshis received by this output.
+    value: u64,
+    /// Decoded memo text, if present and non-empty.
+    memo: Option<String>,
+    /// Block height where the transaction was mined.
+    block_height: Option<u32>,
+    /// Number of confirmations based on the current wallet chain tip.
+    confirmations: u32,
+    /// Current chain status for the transaction.
+    status: ReceivedPaymentStatusType,
+    /// Pool containing this output.
+    pool: String,
+}
+
+#[wasm_bindgen]
+impl ReceivedPayment {
+    #[wasm_bindgen(getter)]
+    pub fn payment_id(&self) -> String {
+        self.payment_id.clone()
+    }
+
+    #[wasm_bindgen(getter)]
+    pub fn txid(&self) -> String {
+        self.txid.clone()
+    }
+
+    #[wasm_bindgen(getter)]
+    pub fn value(&self) -> u64 {
+        self.value
+    }
+
+    #[wasm_bindgen(getter)]
+    pub fn memo(&self) -> Option<String> {
+        self.memo.clone()
+    }
+
+    #[wasm_bindgen(getter)]
+    pub fn block_height(&self) -> Option<u32> {
+        self.block_height
+    }
+
+    #[wasm_bindgen(getter)]
+    pub fn confirmations(&self) -> u32 {
+        self.confirmations
+    }
+
+    #[wasm_bindgen(getter)]
+    pub fn status(&self) -> ReceivedPaymentStatusType {
+        self.status
+    }
+
+    #[wasm_bindgen(getter)]
+    pub fn pool(&self) -> String {
+        self.pool.clone()
+    }
+}
+
+/// Response containing exact received payment outputs.
+#[derive(Debug, Clone, Serialize, Deserialize)]
+#[wasm_bindgen(inspectable)]
+pub struct ReceivedPaymentResponse {
+    payments: Vec<ReceivedPayment>,
+}
+
+#[wasm_bindgen]
+impl ReceivedPaymentResponse {
+    #[wasm_bindgen(getter)]
+    pub fn payments(&self) -> JsValue {
+        serde_wasm_bindgen::to_value(&self.payments).unwrap_or(JsValue::NULL)
+    }
+}
+
