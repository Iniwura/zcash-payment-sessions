    "demo:build": "npm run demo:prepare && vite build --config examples/checkout/vite.config.ts",
    "demo:typecheck": "tsc -p examples/checkout/tsconfig.json --noEmit",
    "demo:preview": "vite preview --config examples/checkout/vite.config.ts"
  },
  "keywords": [],
  "type": "module",
  "devDependencies": {
    "@types/node": "^26.6.3",
