{
  "name": "zcash-payment-sessions",
  "version": "1.0.0",
  "description": "",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "dependencies": {
    "@chainsafe/webzjs-requests": "file:.deps/WebZjs/packages/webzjs-requests",
